<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="24dp"
    android:paddingTop="8dp">

    <TextView
        android:id="@+id/hide_artists_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:textAppearance="@style/TextViewBody1" />

    <RadioGroup
        android:id="@+id/hide_duration_group"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:checkedButton="@+id/hide_until_unhide">

        <com.google.android.material.radiobutton.MaterialRadioButton
            android:id="@+id/hide_until_unhide"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/hide_until_unhide" />

        <com.google.android.material.radiobutton.MaterialRadioButton
            android:id="@+id/hide_one_day"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/hide_one_day" />

        <com.google.android.material.radiobutton.MaterialRadioButton
            android:id="@+id/hide_one_week"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/hide_one_week" />

        <com.google.android.material.radiobutton.MaterialRadioButton
            android:id="@+id/hide_one_month"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/hide_one_month" />

        <com.google.android.material.radiobutton.MaterialRadioButton
            android:id="@+id/hide_custom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/hide_custom_days" />
    </RadioGroup>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.google.android.material.slider.Slider
            android:id="@+id/hide_days_slider"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:stepSize="1"
            android:value="14"
            android:valueFrom="1"
            android:valueTo="365"
            app:labelBehavior="gone"
            app:tickVisible="false" />

        <androidx.appcompat.widget.AppCompatEditText
            android:id="@+id/hide_days_edit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:gravity="end|center_vertical"
            android:imeOptions="actionDone"
            android:importantForAutofill="no"
            android:inputType="number"
            android:maxLength="4"
            android:minEms="2"
            android:selectAllOnFocus="true"
            android:singleLine="true"
            android:textAppearance="@style/TextViewSubtitle1" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:text="@string/hide_days_unit"
            android:textAppearance="@style/TextViewSubtitle1"
            android:textColor="?android:attr/textColorSecondary" />
    </LinearLayout>
</LinearLayout>
